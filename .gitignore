# ==============================================================================
# IoT HIVE - Production & Security .gitignore
# Prevents leaking secrets, credentials, databases, cache, and OS files
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
secrets.json
*.pem
*.key
*.cert
*.pfx

# --- Database & Local Storage ---
*.sqlite3
*.sqlite3-journal
db.sqlite3
local_db/

# --- Large Raw Media & Video Files ---
*.mov
*.mp4
*.webm
*.avi
*.mkv

# --- User Uploaded Media Directory ---
media/
media/*

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs & Test Reports ---
*.log
logs/
.coverage
htmlcov/
.pytest_cache/

# --- Scratch & Temporary Scripts ---
django_backend_extracted/
seed_project.py
scratch/
temp/
