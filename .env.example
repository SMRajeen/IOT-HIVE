# ==============================================================================
# IoT HIVE - Environment Configuration Template (.env.example)
# Copy this file to .env and configure your production values.
# NEVER commit your real .env file to public source control.
# ==============================================================================

# Django Core
SECRET_KEY=your-django-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,yourdomain.com

# Database (Leave blank for default SQLite or configure PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/iothive

# SMS Gateway Configuration (Sri Lanka: notifylk, International: twilio, Dev: console)
SMS_GATEWAY=notifylk
NOTIFY_LK_USER_ID=your_notifylk_user_id
NOTIFY_LK_API_KEY=your_notifylk_api_key
NOTIFY_LK_SENDER_ID=IOTHIVE

# Twilio SMS (Optional alternative)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Payment Gateway (PayHere Sri Lanka)
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_SECRET=your_merchant_secret
PAYHERE_SANDBOX=True

# Static & Media Storage
STATIC_ROOT=staticfiles
MEDIA_ROOT=media
